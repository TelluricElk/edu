<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.eduappml"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <!-- Разрешение на доступ к интернету (нужно для загрузки KaTeX с CDN) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Голосовой режим Edu.AI (Yandex AI Studio Realtime): микрофон пишется
        напрямую через AudioRecord и уходит по WebSocket в наш релей, см.
        пакет com.eduappml.voice. Разрешение запрашивается в рантайме при
        первом нажатии на кнопку микрофона в ChatScreen.kt — до этого момента
        приложение микрофон не трогает.

        MODIFY_AUDIO_SETTINGS нужен эхоподавителю (AcousticEchoCanceler):
        без него ассистент слышит собственный голос из динамика и перебивает
        сам себя. Разрешение обычное, диалога пользователю не показывает.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
         Голосовой режим без микрофона не работает, но и остальное приложение
         из-за его отсутствия блокировать незачем.
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <permission
        android:name="com.eduappml.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.eduappml.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.EduAppML"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.eduappml.MainActivity"
            android:configChanges="uiMode|screenLayout|screenSize|orientation"
            android:exported="true"
            android:theme="@style/Theme.EduAppML.Splash"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.eduappml.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>
        <provider
            android:name="ru.noties.jlatexmath.JLatexMathInitProvider"
            android:authorities="com.eduappml.jlatexmathinitprovider"
            android:exported="false" />

        <!--
            FileProvider для кнопки "Снять на камеру" в чате Edu.AI.
            ActivityResultContracts.TakePicture требует content://-ссылку на файл,
            в который системная камера положит снимок; выдать её может только
            провайдер. Раскрывается ровно один каталог - camera/ во внутреннем
            кэше приложения, см. res/xml/file_paths.xml и createCameraUri()
            в ui/chat/ChatScreen.kt.

            Authority записан целиком, а не через ${applicationId}: в этом
            манифесте все authorities уже прописаны явно (androidx-startup,
            jlatexmathinitprovider) - держим единый стиль. Значение должно
            совпадать с fileProviderAuthority() в ChatScreen.kt, то есть
            с packageName + ".fileprovider".

            Разрешение CAMERA не нужно: снимок делает системное приложение
            камеры. Разрешения на запись тоже не нужны: сохранение картинки
            в галерею идёт через MediaStore (см. ChatImageViewer.kt).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.eduappml.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>