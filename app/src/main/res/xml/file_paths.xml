<?xml version="1.0" encoding="utf-8"?>
<!--
    Пути, которые FileProvider разрешает отдавать наружу по content://-ссылке.

    Нужен ровно один: подкаталог camera/ во внутреннем кэше приложения —
    туда системная камера кладёт снимок, сделанный из чата (см.
    createCameraUri() в ChatScreen.kt). Ничего, кроме этого каталога,
    провайдер не раскрывает.
-->
<paths>
    <cache-path name="chat_camera" path="camera/" />
</paths>
