<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Значение по умолчанию — для телефонов (меньшая сторона экрана < 600dp).
        Интерфейс приложения построен под портрет: позиции пузырей на карте
        знаний заданы долями высоты, экраны урока рассчитаны на вертикальную
        прокрутку. В ландшафте на телефоне высота падает примерно до 200dp,
        и карта сплющивается в горизонтальную полоску.

        Читается в MainActivity.onCreate(). Чтобы разрешить поворот и на
        телефонах — поменяйте здесь true на false, пересобирать больше ничего
        не нужно.
    -->
    <bool name="portrait_only">true</bool>

</resources>
