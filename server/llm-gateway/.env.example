# ---- llm.armintel.ru ------------------------------------------------------
# Токен доступа (JWT из личного кабинета). НЕ коммитить.
ARMINTEL_API_KEY=

# Адреса OpenAI-совместимого API. Менять обычно не нужно.
ARMINTEL_CHAT_URL=https://llm.armintel.ru/api/v1/chat/completions
ARMINTEL_MODELS_URL=https://llm.armintel.ru/api/v1/models

# Модель по умолчанию — на ней отвечает приложение, пока пользователь
# не выбрал другую в списке.
ARMINTEL_MODEL=gemma-3-27b-it

# Список моделей для выпадашки в приложении: "id|подпись|примечание"
# через запятую. Приложение берёт его через GET /models, поэтому набор
# моделей меняется перезапуском сервиса, БЕЗ пересборки APK.
#
# Что проверено вживую 17.09.2026 (см. README, раздел «Какие модели годятся»):
#   gemma-3-27b-it               ~1 с, чисто по-русски
#   Qwen3.8-Flash-Next           ~2 с, чисто
#   FastContext-1.0-4B-SFT       ~3 с, самая лёгкая
#   DeepSeek-V4-Flash-Vision-Exp ~25 с, понимает картинки
# Пусто — шлюз отдаст весь список с upstream, включая модели, которые
# отвечают минутами или не отвечают вовсе.
# Запятая разделяет модели, поэтому внутри примечания её быть не должно.
ARMINTEL_MODELS=gemma-3-27b-it|Gemma 3 27B|Google · быстрая,Qwen3.8-Flash-Next|Qwen3.8 Flash|Alibaba · быстрая,DeepSeek-V4-Flash-Vision-Exp|DeepSeek V4 Flash|DeepSeek · видит картинки,FastContext-1.0-4B-SFT|FastContext 4B|самая лёгкая

# Параметры генерации
ARMINTEL_TEMPERATURE=0.7
# Рассуждающим моделям мало 512: весь бюджет уходит в размышления,
# а на ответ ничего не остаётся.
ARMINTEL_MAX_TOKENS=1024
# Сколько ждём ответ. Больше 60 с смысла почти нет: nginx на той стороне
# рвёт запрос по своему таймауту и отдаёт 504.
ARMINTEL_TIMEOUT_MS=75000

# Системный промпт. Пусто — берётся встроенный (Edu.AI, темы курса,
# LaTeX между $$, без таблиц).
# ARMINTEL_SYSTEM_PROMPT=

# Вырезать ли теги размышлений (<think>…</think> и подобные) из ответа.
STRIP_REASONING=true

# ---- Проверка пользователя через Supabase --------------------------------
# Тот же адрес, что BASE_URL в ApiClient.kt. Шлюз дёргает /auth/v1/user,
# поэтому локально быстрее указать внутренний адрес Kong.
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_ANON_KEY=
# Статический ключ только для отладки через curl. В проде оставить пустым,
# тогда пускает исключительно Supabase-токен пользователя.
LLM_GATEWAY_KEY=

# ---- Сеть ----------------------------------------------------------------
PORT=8788
HOST=0.0.0.0
# Префикс путей. Пусто — /chat, /models, /health. При проксировании через
# nginx удобно поставить /llm; префикс /llm понимается в любом случае.
BASE_PATH=

# ---- Лимиты --------------------------------------------------------------
HISTORY_LIMIT=20
MAX_BODY_BYTES=12582912
MAX_CONCURRENT=6
LOG_LEVEL=info
