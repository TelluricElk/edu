# ---- Yandex AI Studio ----------------------------------------------------
# Секретный ключ сервисного аккаунта (Api-Key). НЕ коммитить.
YANDEX_API_KEY=
# Идентификатор каталога Yandex Cloud (b1g...)
YANDEX_FOLDER_ID=
# Модель Realtime и голос синтеза
YANDEX_MODEL=speech-realtime-250923
YANDEX_VOICE=marina

# Как отвечает ассистент:
#   audio — отвечает синтезированной речью голосом YANDEX_VOICE (по умолчанию)
#   text  — слушает голосом, но отвечает только текстом в ленту чата
# Приложение узнаёт режим из события `ready`, поэтому переключение
# не требует пересборки APK — достаточно перезапустить сервис.
OUTPUT_MODE=audio

# Системный промпт голосового помощника. Если пусто — берётся встроенный
# (Edu.AI, темы курса, короткие устные ответы).
# VOICE_INSTRUCTIONS=

# ---- Проверка пользователя через Supabase --------------------------------
# Тот же адрес, что BASE_URL в ApiClient.kt. Релей дергает /auth/v1/user,
# поэтому локально быстрее указать внутренний адрес Kong.
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_ANON_KEY=
# Статический ключ только для отладки через wscat. В проде оставить пустым.
VOICE_RELAY_KEY=

# ---- Детектор речи -------------------------------------------------------
# Подобрано под поведение голосового ввода в поиске Google. Порог выше 0.5,
# чтобы шум и дыхание не считались речью; пауза длиннее, чтобы человека не
# обрывали на полуслове, когда он задумался в середине фразы.
VAD_THRESHOLD=0.6
VAD_SILENCE_MS=1200
VAD_PREFIX_MS=300

# ---- Сеть ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
VOICE_PATH=/voice

# ---- Аудио ---------------------------------------------------------------
# Частоты, на которых работает приложение. Менять не нужно.
CLIENT_IN_RATE=16000
CLIENT_OUT_RATE=24000
# Частоты, которые уходят в Яндекс. Пусто = совпадают с клиентскими.
# Если Realtime API откажется принимать 16000/24000 — поставьте 44100/44100,
# релей сам пересчитает поток, приложение править не придётся.
YANDEX_IN_RATE=
YANDEX_OUT_RATE=

# ---- Лимиты --------------------------------------------------------------
MAX_SESSION_MS=600000
MAX_CONCURRENT=8
IDLE_TIMEOUT_MS=90000
LOG_LEVEL=info
